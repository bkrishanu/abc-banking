<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">ABC Bank</string>

    <!-- Wordmark: a logo, not copy -->
    <string name="wordmark_abc" translatable="false">abc</string>
    <string name="wordmark_bank" translatable="false">bank</string>

    <!-- Accessibility -->
    <string name="cd_abc_bank_logo">ABC Bank</string>
    <string name="cd_back">Back</string>
    <string name="cd_delete">Delete</string>
    <string name="button_loading">Loading</string>
    <!-- PluralsCandidate: "3 of 6 entered" reads the same for every count, so no plural forms. -->
    <string name="mpin_progress" tools:ignore="PluralsCandidate">%1$d of %2$d entered</string>

    <!-- Welcome -->
    <string name="welcome_headline">Effortless banking, simplified.</string>
    <string name="welcome_subtext">Everyday banking, simplified, in your pocket.</string>
    <string name="welcome_get_started">Get started</string>

    <!-- Login -->
    <string name="login_title">Log in</string>
    <string name="login_customer_id_label">Customer ID</string>
    <string name="login_customer_id_placeholder">8 letters or numbers</string>
    <string name="login_customer_id_error_format">Customer ID is 8 letters or numbers.</string>
    <string name="login_customer_id_error_unknown">We don\'t recognise this customer ID.</string>
    <string name="login_mpin_label">Enter your MPIN</string>
    <string name="login_replaces_data">Logging in replaces %1$s\'s demo data.</string>
    <string name="login_setting_up">Setting up your demo data…</string>
    <string name="login_setup_failed">We couldn\'t set up your demo data. Check your connection and enter your MPIN again.</string>

    <!-- MPIN pad messages -->
    <plurals name="mpin_wrong_attempts_left">
        <item quantity="one">Wrong MPIN. %d attempt left.</item>
        <item quantity="other">Wrong MPIN. %d attempts left.</item>
    </plurals>
    <string name="mpin_locked_countdown">Try again in %d s</string>
</resources>
